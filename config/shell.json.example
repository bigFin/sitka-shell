{
    "general": {
        // "theme": "EverforestDark"
        // Available themes: "EverforestDark", "EverforestLight", "RosePine", "HighTest"
        "theme": "EverforestDark"
    },
    "appearance": {
        // Corner style: 0=radius, 1=chamfer, 2=fillet
        "filletStyle": 1,
        "font": {
            "family": {
                // Font for sans-serif text.
                "sans": "Iosevka Term",
                // Font for monospaced text.
                "mono": "Iosevka Term",
                // Icon font.
                "material": "MaterialSymbolsSharp",
                // Font for the clock.
                "clock": "Iosevka Term"
            }
        },
        // Transparent rice mode. Text/accent colors stay opaque; shell surfaces use these alpha values.
        "transparency": {
            // "opaque" disables surface alpha, "normal" respects enabled/base/layers,
            // and "transparent" forces transparency even if enabled is false.
            "mode": "opaque",
            // Legacy toggle used by "normal" mode.
            "enabled": false,
            // Alpha for primary shell surfaces. "transparent" defaults to 0.34.
            "base": 0.58,
            // Alpha for nested panels, cards, and raised layers. "transparent" defaults to 0.11.
            "layers": 0.24,
            // Alpha for modal dimming/scrims. "transparent" defaults to 0.28.
            "scrim": 0.5
        },
        // Shader effects for VFD/CRT visual style
        "shaders": {
            // Enable shader effects
            "enabled": false,
            // Path to custom GLSL shader (auto-compiled to .qsb)
            "customShader": "~/.config/sitka/shaders/retro-terminal.glsl",
            // Effect intensity: 0.0 to 1.0
            "intensity": 0.5,
            // Enable time-based animations (for animated effects)
            "animateTime": false,
            // Performance mode: "off" or "dynamic". Dynamic captures the UI into a shader source.
            "performanceMode": "off"
        }
    },
    "bar": {
        // Bar reveal behavior:
        // - "corner": click corner trigger to show bar (default, no window shoving)
        // - "hover": show bar when mouse is near left edge  
        // - "always": bar is always visible
        "revealMode": "corner",
        
        // Overlay mode: when true, bar overlays windows instead of pushing them
        // Only applies when revealMode is "corner" or "hover"
        "overlayMode": true,
        
        // Legacy: whether bar starts pinned (visible)
        "persistent": false,
        
        // Corner trigger settings (when revealMode is "corner")
        "cornerTrigger": {
            // Size of the corner hotspot in pixels
            "size": 48,
            // How much it expands on hover
            "hoverExpand": 8,
            // Show OS logo in corner
            "showLogo": true,
            // Scale of logo relative to corner size
            "logoScale": 0.6
        },
        // Workspace labels: "symbol", "number", "name", or "both"
        "workspaces": {
            "displayMode": "symbol"
        },
        
        // Bar entries - order and enable/disable components
        // Available entries: "workspaces", "spacer", "activeWindow", "tray",
        // "clock", "statusIcons", "power", "controlcenter", "papertoy", "idleInhibitor", "gameMode", "logoToggle"
        // Tactical default: workspaces, tray, clock, status. Flip any flag to bring extras back.
        "entries": [
            { "id": "workspaces", "enabled": true },
            { "id": "spacer", "enabled": true },
            { "id": "activeWindow", "enabled": false },
            { "id": "spacer", "enabled": true },
            { "id": "tray", "enabled": true },
            { "id": "clock", "enabled": true },
            { "id": "statusIcons", "enabled": true },
            { "id": "power", "enabled": false },
            { "id": "controlcenter", "enabled": false },
            { "id": "logoToggle", "enabled": false }
        ]
    },
    "services": {
        "agentUsage": {
            // Primary Codex weekly quota is shown by default.
            "showCodex": true,
            "showAdditionalCodexLimits": false,
            "showClaude": false
        },
        "papertoy": {
            // Path to the GLSL shader file for papertoy
            "shaderPath": "",
            // Additional command-line arguments for papertoy
            "args": []
        }
    },
    "paths": {
        // Rotate decoration images by pointing these at directories.
        // Empty keeps the single sessionGif/mediaGif images.
        "sessionGifDir": "",
        "mediaGifDir": "",
        // Seconds between swaps; 0 disables cycling.
        "decorationCycleSeconds": 0
    }
}
